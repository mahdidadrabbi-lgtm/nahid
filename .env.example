# Copy this file to .env.local and replace these placeholders with real values.
# FIREBASE_SERVICE_ACCOUNT must be the complete service-account JSON on one line.
# Never commit .env.local or share the service-account JSON.
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FIREBASE_SERVICE_ACCOUNT=
